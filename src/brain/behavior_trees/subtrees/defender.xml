<root BTCPP_format="4" >
    <include path="./subtree_cam_find_and_track_ball.xml" />
    <include path="./subtree_locate.xml" />

    <BehaviorTree ID="defender">
        <Sequence name="root">                  

            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <CalcKickDirPF opponent_repulse_gain = "2" goal_attract_gain = "5"/>
            <SelfLocate mode="trust_direction" />            
            <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.5"/>
            <Sequence _while="decision == 'find'">
                <RobotFindBall />
            </Sequence>
            <DefenceChase _while="decision == 'retreat'" />
            <Chase   _while="decision == 'chase'"  vx_limit="0.9"  vy_limit="0.2"  vtheta_limit="1.0"  dist="0.1" safe_dist="0.5" />
            <Adjust _while="decision =='adjust'" turn_threshold="0.5" range="0.8" vx_limit="0.6" vy_limit="0.7" vtheta_limit="1.5" vtheta_factor="3.5" tangential_speed_far="0.9" tangential_speed_near="0.4" />
            <Kick _while="decision == 'kick'" speed_limit="0.8" min_msec_kick="1000" msecs_stablize="1000"/>

        </Sequence>
    </BehaviorTree>
</root>