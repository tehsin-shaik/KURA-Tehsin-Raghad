<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="goalie">
      <ReactiveSequence >
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="等待对方开球">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="已方开球或对方已经开球">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
	    <ReactiveSequence _while="!ball_out">
               <ReactiveSequence _while="wait_for_opponent_kickoff" name="等待对方开球">
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <SetVelocity />
               </ReactiveSequence>
               <Sequence _while="!wait_for_opponent_kickoff" name="正常比赛">
                  <Sequence>
                     <SelfLocate mode="trust_direction" msecs_interval="2000"/>
                     <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
	                     <CalcKickDirPF goal_attract_gain = "10" edge_influence_dist = "3.5" edge_repulse_gain = "5"/>
	                     <newGoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0"/>
	                     <SubTree ID="FindBall" _autoremap="true" _while="decision=='find'"/>
	                     <MoveToPoseOnField
	                        _while="decision == 'goal_block'"
	                        x="-7.0"
	                        y="0.0"
	                        theta="0.0"
	                        vx_limit="0.8"
	                        vy_limit="0.5"
	                        vtheta_limit="0.8"
	                        x_tolerance="0.25"
	                        y_tolerance="0.25"
	                        theta_tolerance="0.4"
	                        avoid_obstacle="true"/>
	                     <Y_Keeper _while="decision == 'retreat'" theta_tolerance="0.6" />
	                     <Chase   _while="decision == 'chase'"  vx_limit="0.9"  vy_limit="0.2"  vtheta_limit="1.0"  dist="0.1" safe_dist="0.5" />
                     <Adjust _while="decision =='adjust'" turn_threshold="0.5" range="0.8" vx_limit="1.0" vy_limit="1.0" vtheta_limit="1.5" vtheta_factor="3.5" tangential_speed_far="0.9" tangential_speed_near="0.4" />
                     <Kick _while="decision == 'kick'" speed_limit="3.5" min_msec_kick="1500" msecs_stablize="500"/>
                  </Sequence>
               </Sequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
