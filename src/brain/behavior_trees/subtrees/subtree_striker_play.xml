<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="StrikerPlay">
      <ReactiveSequence>
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="等待对方开球">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="/正常比赛, 即已方开球或对方已经开球">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
            <ReactiveSequence _while="!ball_out">
               <ReactiveSequence >
                  <SelfLocate mode="trust_direction" msecs_interval="300"/>    
		            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <CalcKickDirPF opponent_repulse_gain = "2" goal_attract_gain = "5" goal_reward_gain="9.0" />
                  <Sequence>
                     <ReactiveSequence>
                        <StrikerDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="3.0" />
                        <SubTree ID="FindBall" _while="decision=='find'" _autoremap="true" />
                     </ReactiveSequence>
                        <DefenceChase _while="decision == 'retreat'" vx_limit = "0.2" vy_limit="0.8" />
                        <Chase   _while="decision == 'chase'"  speed = "1" vx_limit="1.5"  vy_limit="0.6"  vtheta_limit="1.4"  dist="0.1" safe_dist="0.5" />
                        <Adjust _while="decision =='adjust'" turn_threshold="0.2" range="0.75" vx_limit="2.3" vy_limit="1.7" vtheta_limit="3.2" vtheta_factor="5.0" tangential_speed_far="1.5" tangential_speed_near="0.5" turn_first_threshold="0.5" />
                        <KickLeg _while="decision == 'shoot'" />
                        <Kick _while="decision == 'kick'" speed_limit="2.4" min_msec_kick="800" msecs_stablize="500"/>
                        <Kick _while="decision == 'cross'" speed_limit="0.6" min_msec_kick="300"/>
                  </Sequence>
               </ReactiveSequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>


